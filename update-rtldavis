#!/usr/bin/env python3
"""Vendor an approved standalone Python RTL-Davis release."""

import ast
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import urllib.request

REPOSITORY = "cdavis289/weewx-rtldavis-py"
DOCKERFILE = Path("Dockerfile.rtldavis")
DESTINATION = Path("test-assets/rtldavis")

MODULES = (
    "rtldavis.py",
    "rtldavis_receiver.py",
    "rtldavis_dsp.py",
    "rtldavis_gust_diagnostics.py",
    "rtldavis_frame_diagnostics.py",
    "rtldavis_phase_c_diagnostics.py",
    "rtldavis_diagnostic_storage.py",
    "rtldavis_wind_validation.py",
)

TAG_PATTERN = r"v([0-9]+\.[0-9]+\.[0-9]+)-prod\.([1-9][0-9]*)"


def fail(message):
    raise SystemExit(f"ERROR: {message}")


def fetch_json(url):
    request = urllib.request.Request(
        url, headers={"User-Agent": "weewx-docker-rtldavis-updater"}
    )
    if request.type != "https":
        fail("Only HTTPS URLs are permitted")
    with urllib.request.urlopen(request, timeout=30) as response:  # nosec B310
        return json.load(response)


def replace_once(text, old, new):
    if text.count(old) != 1:
        fail(f"Unexpected source: {old}")
    return text.replace(old, new, 1)


def update_arg(text, name, value):
    pattern = rf"^ARG {name}=.*$"
    text, count = re.subn(
        pattern, f"ARG {name}={value}",
        text, flags=re.MULTILINE
    )
    if count != 1:
        fail(f"Expected one declaration for {name}")
    return text


def release_key(tag):
    match = re.fullmatch(TAG_PATTERN, tag)
    if not match:
        fail(f"Invalid production release: {tag}")
    return tuple(map(int, match.group(1).split("."))) + (
        int(match.group(2)),
    )


def latest_release():
    releases = fetch_json(
        f"https://api.github.com/repos/{REPOSITORY}/releases?per_page=100"
    )
    eligible = [
        release["tag_name"] for release in releases
        if not release.get("draft")
        and not release.get("prerelease")
        and re.fullmatch(TAG_PATTERN, release.get("tag_name", ""))
    ]
    return max(eligible, key=release_key) if eligible else None


def main():
    if sys.argv[1:] == ["--latest"]:
        print(latest_release() or "")
        return

    if len(sys.argv) != 2:
        fail("Usage: ./update-rtldavis vX.Y.Z-prod.N")

    tag = sys.argv[1]
    key = release_key(tag)
    version = ".".join(map(str, key[:3]))

    release = fetch_json(
        f"https://api.github.com/repos/{REPOSITORY}/releases/tags/{tag}"
    )

    if (release.get("draft") or release.get("prerelease")
            or release.get("tag_name") != tag):
        fail("Release is not an approved stable production release")

    current = json.loads(
        (DESTINATION / "source-manifest.json").read_text()
    )
    current_tag = current.get("release", "unreleased")

    current_version = tuple(
        map(int, current["driver_version"].split("."))
    )

    if key[:3] < current_version:
        fail("Automatic driver downgrade is not permitted")

    if current_tag != "unreleased" and key < release_key(current_tag):
        fail("Automatic driver downgrade is not permitted")

    changes = {}
    hashes = {}

    with tempfile.TemporaryDirectory() as directory:
        subprocess.run(
            ["git", "clone", "--quiet", "--depth", "1",
             "--branch", tag,
             f"https://github.com/{REPOSITORY}.git", directory],
            check=True,
        )

        commit = subprocess.check_output(
            ["git", "-C", directory, "rev-parse", "HEAD"],
            text=True,
        ).strip()

        if not re.fullmatch(r"[0-9a-f]{40}", commit):
            fail("Invalid resolved commit")

        if current_tag == tag and current["commit"] != commit:
            fail("Previously pinned release tag has moved")

        if current_tag == tag:
            print("Release already installed:", tag)
            return

        source = Path(directory) / "bin/user"

        actual = {p.name for p in source.glob("rtldavis*.py")}
        if actual != set(MODULES):
            fail(f"Unexpected driver module set: {actual}")

        for name in MODULES:
            raw = (source / name).read_bytes()
            text = raw.decode("utf-8")

            if name == "rtldavis.py":
                tree = ast.parse(text)
                versions = [
                    ast.literal_eval(node.value)
                    for node in tree.body
                    if isinstance(node, ast.Assign)
                    and any(
                        isinstance(target, ast.Name)
                        and target.id == "DRIVER_VERSION"
                        for target in node.targets
                    )
                ]

                if versions != [version]:
                    fail(f"Driver version mismatch: {versions}")

                text = replace_once(
                    text,
                    "        stn_dict = config_dict.get(DRIVER_NAME, {})\n",
                    "        stn_dict = config_dict.get(DRIVER_NAME, {})\n"
                    "        self._hardware_name = stn_dict.get("
                    "'hardware_name', 'Rtldavis')\n",
                )

                text = replace_once(
                    text,
                    "    def hardware_name(self):\n"
                    "        return 'Rtldavis'\n",
                    "    def hardware_name(self):\n"
                    "        return self._hardware_name\n",
                )

            text = "\n".join(
                line.rstrip(" \t") for line in text.split("\n")
            )

            compile(text, name, "exec")
            content = text.encode("utf-8")

            hashes[name] = {
                "source_sha256": hashlib.sha256(raw).hexdigest(),
                "vendored_sha256": hashlib.sha256(content).hexdigest(),
            }
            changes[DESTINATION / name] = content

    docker = DOCKERFILE.read_text()
    for name, value in (
        ("RTL_DAVIS_REF", "v" + version),
        ("RTL_DAVIS_RELEASE", tag),
        ("RTL_DAVIS_REPOSITORY", REPOSITORY),
        ("RTL_DAVIS_COMMIT", commit),
    ):
        docker = update_arg(docker, name, value)

    changes[DOCKERFILE] = docker.encode("utf-8")

    manifest = {
        "repository": REPOSITORY,
        "release": tag,
        "commit": commit,
        "driver_version": version,
        "customizations": [
            "Configurable hardware_name in rtldavis.py",
            "Trailing whitespace normalization",
        ],
        "modules": hashes,
    }

    changes[DESTINATION / "source-manifest.json"] = (
        json.dumps(manifest, indent=2, sort_keys=True) + "\n"
    ).encode("utf-8")

    for path, content in changes.items():
        path.write_bytes(content)
        print("Updated:", path)

    print("Production release:", tag)
    print("Driver version:", version)
    print("Pinned commit:", commit)


if __name__ == "__main__":
    main()
